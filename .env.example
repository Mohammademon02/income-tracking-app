# Copy to .env and fill in real values. Never commit .env itself.
#
# IMPORTANT: if a .env.production file exists, Next.js loads it *over* .env
# when NODE_ENV is production — so `npm start` and any production deploy use
# those values, not these. A half-filled .env.production is worse than none:
# a placeholder DATABASE_URL there produces 500s and a mismatched JWT_SECRET
# produces 401s, while .env sits there looking correct. Either fill it in
# completely or delete it and set the variables in your host's dashboard.

# MongoDB connection string
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority"

# Login credentials for the single application user
APP_USERNAME="<YOUR_USERNAME>"
APP_PASSWORD="<YOUR_PASSWORD>"

# Session signing key. Must be at least 32 characters — the app refuses to
# start without it. Generate one with:  openssl rand -base64 36
JWT_SECRET="<YOUR_RANDOM_SECRET_AT_LEAST_32_CHARS>"

# IANA timezone that defines the business day — which calendar date counts as
# "today", and where each month starts and ends. This must NOT depend on where
# the app is deployed, so it is set explicitly. Defaults to America/Chicago.
NEXT_PUBLIC_APP_TIMEZONE="America/Chicago"

# Web Push (VAPID). Generate a pair with:  npx web-push generate-vapid-keys
# The public key is sent to the browser by design. The private key signs push
# messages and must never be exposed — without both, push is simply disabled
# and in-app notifications continue to work.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="<YOUR_VAPID_PUBLIC_KEY>"
VAPID_PRIVATE_KEY="<YOUR_VAPID_PRIVATE_KEY>"
# Contact address push services can use to reach you about your pushes.
VAPID_SUBJECT="mailto:you@example.com"
