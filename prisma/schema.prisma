generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  color     String   @default("blue")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries     DailyEntry[]
  withdrawals Withdrawal[]

  @@map("accounts")
}

model DailyEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime
  points    Float
  accountId String   @db.ObjectId
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([accountId])
  @@index([date, accountId])
  @@map("daily_entries")
}

model Withdrawal {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime         // Request date
  amount      Float
  status      WithdrawalStatus @default(PENDING)
  completedAt DateTime?        // Completion date (nullable)
  accountId   String           @db.ObjectId
  account     Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
  @@index([accountId])
  @@index([date])
  @@map("withdrawals")
}

/// Read/dismissed state for a derived notification.
///
/// Notifications themselves are not stored — they are recomputed from entries
/// and withdrawals on every request, which is why each one has a stable
/// synthetic key such as `withdrawal-completed-<id>` or `daily-goal-<date>`.
/// Only the user's interaction with them needs to persist, and that is this
/// row. The previous `Notification` model was never written to by any code
/// path, while read state lived in process memory and vanished on restart.
model NotificationState {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  /// The synthetic notification id. Not an ObjectId, which is why this cannot
  /// simply reuse the primary key.
  key       String    @unique
  read      Boolean   @default(false)
  dismissed Boolean   @default(false)
  readAt    DateTime?
  /// When a web push was sent for this notification. Its presence is what
  /// stops the same event being pushed again on every subsequent mutation.
  pushedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([read])
  @@index([dismissed])
  @@map("notification_states")
}

/// A browser push endpoint registered by the PWA service worker.
model PushSubscription {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  endpoint   String    @unique
  /// Client public key from the PushSubscription keys object.
  p256dh     String
  /// Client auth secret from the PushSubscription keys object.
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@map("push_subscriptions")
}

model UserSettings {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  dailyGoalPoints       Int      @default(2000)
  weeklyGoalPoints      Int      @default(14000)
  monthlyGoalPoints     Int      @default(60000)
  notificationsEnabled  Boolean  @default(true)
  emailNotifications    Boolean  @default(false)
  pushNotifications     Boolean  @default(true)
  quietHoursStart       String?  @default("22:00")
  quietHoursEnd         String?  @default("08:00")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("user_settings")
}

enum WithdrawalStatus {
  PENDING
  COMPLETED
}

// NotificationType and NotificationPriority are no longer Prisma enums: no
// column stores them now that notifications are derived rather than persisted.
// They live as TypeScript unions in lib/notifications/events.ts instead.
